{
  "name": "Reverse Penny Drop — BAV micro-interaction",
  "description": "Motion spec for the four-state Reverse Penny Drop bank-account-verification card. Only the contents of the inner white card animate; the surrounding screen is static. All times in milliseconds, relative to sequence start. Hard cap: 5000ms.",
  "version": "1.0.0",
  "meta": {
    "totalDuration": 4800,
    "hardCap": 5000,
    "loop": false,
    "replay": "tap-or-button",
    "reducedMotionFallback": "snap-to-final"
  },
  "easing": {
    "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
    "decelerate": "cubic-bezier(0, 0, 0.2, 1)",
    "accelerate": "cubic-bezier(0.4, 0, 1, 1)"
  },
  "principles": [
    "The inner white card keeps fixed geometry across all four states.",
    "Transitions overlap slightly so the flow reads as one continuous interaction.",
    "Motion is limited to opacity, <=6px translate, <=1.15 scale pulses, and SVG stroke-draws.",
    "No bounce, elastic, confetti, or large-scale motion."
  ],
  "phases": [
    {
      "id": "s1-reveal",
      "screen": 1,
      "label": "Choose UPI — content reveals",
      "start": 0,
      "end": 600,
      "elements": {
        "upiLogo": { "in": { "start": 0, "duration": 320, "opacity": [0, 1], "translateY": [8, 0], "scale": [0.96, 1], "easing": "decelerate" } },
        "appIcons": {
          "stagger": 90,
          "each": { "start": 160, "duration": 300, "opacity": [0, 1], "translateY": [6, 0], "scale": [0.9, 1], "easing": "decelerate" }
        }
      }
    },
    { "id": "s1-hold", "screen": 1, "label": "Hold on Choose UPI", "start": 600, "end": 1000 },
    {
      "id": "s1-to-s2",
      "from": 1, "to": 2,
      "label": "Choose UPI -> Enter PIN (card fixed, contents swap)",
      "start": 1000, "end": 1320,
      "out": { "target": "layer-upi", "start": 1000, "duration": 220, "opacity": [1, 0], "scale": [1, 0.98], "easing": "accelerate" },
      "in": { "target": "layer-pin", "start": 1120, "duration": 300, "opacity": [0, 1], "translateY": [6, 0], "easing": "decelerate" }
    },
    {
      "id": "s2-pin-entry",
      "screen": 2,
      "label": "Realistic 4-digit PIN entry — sequential fill with keypress pulse",
      "start": 1450, "end": 2450,
      "dots": [
        { "index": 0, "fillAt": 1450 },
        { "index": 1, "fillAt": 1750 },
        { "index": 2, "fillAt": 2050 },
        { "index": 3, "fillAt": 2350 }
      ],
      "dotFill": { "duration": 180, "opacity": [0, 1], "scale": [0.5, 1.15, 1], "easing": "standard", "colorTo": "#1C2A6B" }
    },
    {
      "id": "s2-check",
      "screen": 2,
      "label": "Auto-submit beat, then check strokes in",
      "start": 2600, "end": 2850,
      "pauseAfterLastDot": 150,
      "check": { "start": 2600, "duration": 250, "strokeDashoffset": [1, 0], "opacity": [0, 1], "easing": "decelerate" }
    },
    {
      "id": "s2-to-s3",
      "from": 2, "to": 3,
      "label": "PIN complete -> Payment successful (check settles into success)",
      "start": 2900, "end": 3220,
      "out": { "target": "layer-pin", "start": 2900, "duration": 220, "opacity": [1, 0], "scale": [1, 0.98], "easing": "accelerate" },
      "in": {
        "target": "layer-pay", "start": 3000, "duration": 300, "opacity": [0, 1], "translateY": [6, 0], "easing": "decelerate",
        "greenCircle": { "start": 3060, "duration": 260, "opacity": [0, 1], "scale": [0.8, 1], "easing": "decelerate" },
        "greenCheck": { "start": 3160, "duration": 240, "strokeDashoffset": [1, 0], "easing": "decelerate" }
      }
    },
    { "id": "s3-hold", "screen": 3, "label": "Hold on Payment successful", "start": 3220, "end": 3900 },
    {
      "id": "s3-to-s4",
      "from": 3, "to": 4,
      "label": "Payment done -> Bank account verified (natural conclusion)",
      "start": 3900, "end": 4300,
      "out": { "target": "layer-pay", "start": 3900, "duration": 220, "opacity": [1, 0], "scale": [1, 0.98], "easing": "accelerate" },
      "in": {
        "target": "layer-bank", "start": 4020, "duration": 320, "opacity": [0, 1], "translateY": [6, 0], "easing": "decelerate",
        "bankIcon": { "start": 4060, "duration": 300, "opacity": [0, 1], "translateY": [6, 0], "scale": [0.94, 1], "easing": "decelerate" },
        "greenBadge": { "start": 4260, "duration": 220, "opacity": [0, 1], "scale": [0.6, 1], "easing": "decelerate" },
        "texts": { "start": 4200, "duration": 300, "opacity": [0, 1], "translateY": [6, 0], "stagger": 70, "easing": "decelerate" }
      }
    },
    { "id": "s4-settle", "screen": 4, "label": "Rest on Bank account verification successful", "start": 4300, "end": 4800 }
  ]
}
